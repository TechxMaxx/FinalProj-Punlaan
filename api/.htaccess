# Mobile app API: every address under /api/ goes to index.php
#   /api/cart/add?x=1  →  index.php?r=cart/add&x=1
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Some servers drop the "Authorization" header — pass it on to PHP
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(.*)$ index.php?r=$1 [QSA,L]
</IfModule>

# Only index.php may be opened directly
<FilesMatch "^(?!index\.php$).+\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>
